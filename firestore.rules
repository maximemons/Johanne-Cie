rules_version = '2';
// Règles de sécurité Firestore — Johanne & Cie
// Déploiement : firebase deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn()
        && request.auth.token.email == "pro.maxime.mons@gmail.com"
        && request.auth.token.email_verified == true;
    }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }

    // Carte : lecture publique, écriture admin
    match /categories/{id}  { allow read: if true; allow write: if isAdmin(); }
    match /patisseries/{id} { allow read: if true; allow write: if isAdmin(); }

    // Prix de revient : strictement privés
    match /couts/{id} { allow read, write: if isAdmin(); }

    // Paramètres : le programme de fidélité est public (affiché aux clients),
    // les autres réglages (prix suggéré...) sont réservés à l'admin
    match /parametres/{docId} {
      allow read: if docId == "fidelite" || isAdmin();
      allow write: if isAdmin();
    }

    // Commandes
    match /commandes/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.statut == "En attente";
      // Le client peut seulement annuler sa commande, tant qu'elle n'est pas « En préparation »
      // et qu'aucun article ne lui a déjà été remis (retrait partiel)
      allow update: if isAdmin() || (
        signedIn()
        && resource.data.userId == request.auth.uid
        && resource.data.statut in ["En attente", "Acceptée", "Confirmée"]
        && resource.data.get("retraitPartiel", false) == false
        && request.resource.data.statut == "Annulée"
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["statut", "annuleeLe", "annuleePar"])
      );
      allow delete: if isAdmin();
    }

    // Espace client (favoris) : chacun le sien
    match /clients/{uid} {
      allow read, write: if isOwner(uid);
      allow read: if isAdmin();
    }
  }
}
