rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'pro.maxime.mons@gmail.com'
        && request.auth.token.email_verified == true;
    }

    // Catalogue : lecture publique, écriture réservée à l'admin
    match /categories/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /patisseries/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Prix de revient (privé) : lecture ET écriture réservées à l'admin, jamais exposés à la boutique
    match /couts/{id} {
      allow read, write: if isAdmin();
    }

    // Commandes : un client crée et relit les siennes ; l'admin gère tout
    match /commandes/{id} {
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.statut == 'En attente';
      allow read: if isAdmin() || (request.auth != null && resource.data.userId == request.auth.uid);
      allow update, delete: if isAdmin();
    }
  }
}
